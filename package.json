{
  "name": "pearschool-mini",
  "productName": "Pearschool Mini",
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.js",
  "upgrade": "pear://PLACEHOLDER_RUN_PEAR_TOUCH_TO_GENERATE",
  "updates": false,
  "scripts": {
    "clean": "rm -rf build",
    "build:db": "node schema.js",
    "build:swc": "swc ui -d build --copy-files --strip-leading-paths",
    "build:tailwind": "npx @tailwindcss/cli -i input.css -o output.css",
    "build": "npm run build:tailwind && npm run build:swc",
    "start": "electron-forge start",
    "make": "electron-forge make"
  },
  "dependencies": {
    "autobase": "^7.24.0",
    "b4a": "^1.7.3",
    "bare-ffmpeg": "^1.0.0",
    "bare-fs": "^4.5.2",
    "bare-media": "^1.8.0",
    "bare-path": "^3.0.0",
    "blind-pairing": "^2.3.1",
    "blind-peering": "^1.15.0",
    "corestore": "^7.7.0",
    "debounceify": "^1.1.0",
    "framed-stream": "^1.0.1",
    "get-mime-type": "^2.0.2",
    "hrpc": "^4.3.0",
    "hyperblobs": "^2.8.0",
    "hypercore-blob-server": "^1.12.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdb": "^4.19.1",
    "hyperdrive": "^13.0.2",
    "hyperdispatch": "^1.4.4",
    "hyperschema": "^1.17.1",
    "hyperswarm": "^4.16.0",
    "localdrive": "^2.2.0",
    "paparam": "^1.9.1",
    "pear-link": "latest",
    "pear-runtime": "latest",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "ready-resource": "^1.2.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "latest",
    "@electron-forge/maker-deb": "latest",
    "@electron-forge/maker-dmg": "latest",
    "@electron-forge/maker-squirrel": "latest",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.3",
    "@tailwindcss/cli": "^4.1.17",
    "electron": "latest",
    "tailwindcss": "^4.1.17"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  }
}
